VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Optional: app deep link used for Supabase OAuth and password-reset callbacks after auth is connected.
VITE_SUPABASE_AUTH_REDIRECT_URL=com.blockparty.game://auth/callback
# Optional for older Supabase projects; the publishable key above is preferred.
# VITE_SUPABASE_ANON_KEY=replace_me

# Edge Function secrets are configured in Supabase, never in this file or the app:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# SUPABASE_SECRET_KEY=sb_secret_replace_me
